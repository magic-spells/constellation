<puzzle-view>
  <main class="docs">
    {#if empty}
      <div class="docs-grid">
        <div class="docs-column">
          <Empty
            class="min-h-[22rem]"
            title={ emptyTitle }
            description={ emptyDescription }>
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 3h7l4 4v14H7zM14 3v4h4M10 12h6M10 16h4"/>
            </svg>
          </Empty>
        </div>
      </div>
    {:else}
      <div class="docs-grid">
        <!-- Track 1: the contents, right-aligned against the page and sticky.
             It never changes track 2's width, so the document cannot shift
             sideways when this appears or disappears. -->
        <div class="docs-rail"><DocsToc variant="rail" solo={ solo }/></div>

        <div class="docs-column">
          <!-- The same tree as a jump control, for viewports whose gutter is too
               narrow to hold the rail legibly. CSS picks exactly one. -->
          <DocsToc variant="compact" solo={ solo }/>

          <header class="docs-cover">
            <p class="docs-eyebrow">Documentation</p>
            <h1 class="docs-title">{ title }</h1>
            <p class="docs-imprint">{ imprint }</p>
          </header>

          <!-- The printed contents page. Same tree as the rail's TOC, no
               scroll-spy and no links to follow — on paper it is a map, not a
               control. -->
          <nav class="docs-paper-toc" aria-label="Contents">
            <h2>Contents</h2>
            {#for section in sections}
              <div key={ section.id } class="ptoc-group">
                <p class="ptoc-section">{ section.name }</p>
                {#for card in section.cards}
                  <p key={ card.handle } class="ptoc-card">{ card.name }</p>
                {/for}
              </div>
            {/for}
          </nav>

          {#for section in sections}
            <section key={ section.id } class="docs-section">
              <h2 id={ section.anchor } class="docs-section-title">{ section.name }</h2>
              {#if section.summary}<p class="docs-section-summary">{ section.summary }</p>{/if}

              {#for card in section.cards}
                <article key={ card.handle } id={ card.handle } data-doc-anchor={ card.handle } class="docs-card">
                  <a class="docs-card-source" style={ card.typeStyle } href="{ card.cardHref | link }" title={ card.sourceTitle }>{ card.handle }</a>
                  <h3 class="docs-card-title">{ card.name }</h3>
                  <MarkdownBlock src={ card.body } docHandles={ handles } docBase={ base }/>
                </article>
              {/for}
            </section>
          {/for}
        </div>
      </div>
    {/if}
  </main>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Empty from '../components/ui/Empty.pzl';
import DocsToc from '../components/DocsToc.pzl';
import MarkdownBlock from '../components/MarkdownBlock.pzl';
import { anchorAt, sectionAnchor, setActiveDocAnchor } from '../lib/docs.js';
import { hrefForHandle, typeForHandle } from '../lib/types.js';

// DocsPage — `#/docs` and `#/docs/:section`: every sectioned card compiled into
// one document, read top to bottom.
//
// A DOCUMENT, NOT A PANEL. This route is one of AppShell's `wide` shapes, and
// the layout here is a three-track grid: equal flexible gutters either side of
// a capped content column, so the page is centred in the viewport and stays
// centred whether or not the contents rail is showing beside it.
//
// READ-ONLY BY DESIGN. Every other card surface in this viewer edits in place;
// this one does not. The compiled view is a reading order over cards that live
// elsewhere, and an edit box in it would invite writing prose into a document
// that isn't a file. Each card heading carries its handle as a quiet link back
// to the card page, which is where editing happens.
//
// Ordering and heading levels arrive already decided — `GET /api/docs` runs
// src/core/docs.ts, the one compiler, and hands over bodies whose own headings
// are already two levels down. What this view adds is the frame (title, section
// H2, card H3), the anchors, the scroll, and the typography.
//
// DEEP LINKS UNDER HASH ROUTING. The app routes on `location.hash`, so a card
// anchor rides as a SECOND fragment: `#/docs#DOC-FILE-FORMAT` parses to pathname
// `/docs` + hash `#DOC-FILE-FORMAT`. The browser can't resolve that itself (it
// would look for an element whose id is the whole string), so `_scrollToHash`
// does it — which is also what makes Back work between two anchors on the same
// page: each is its own history entry, and the route change re-runs this.
//
// SCROLL-SPY publishes rather than renders: the two TOC renders subscribe to
// lib/docs.js, so neither has to know this view exists. Anchor tops are measured
// against the SplitPanel's second pane, which is the element that actually
// scrolls on every route (see its `overflow-auto` pane class).

/** How far below the pane's top edge the "you are reading this" line sits. */
const READING_LINE = 96;

/** Nothing left to scroll, within a pixel of rounding. */
function atBottom(scroller) {
	return scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 2;
}

export default class DocsPage extends PuzzleView {
	data() {
		const store = this.ctx.store;
		const plan = store.findOne('plan', 'plan');
		const docs = plan?.docs;
		const solo = String(this.route.params?.section ?? '');
		const all = docs?.sections ?? [];
		const sections = solo ? all.filter((section) => section.id === solo) : all;

		// In-document link targets are the handles actually RENDERED here: on
		// `/docs/:section` a card in another section is not on this page, so a
		// [[link]] to it must stay a link to its card, not a dead anchor.
		const handles = sections.flatMap((section) => section.cards.map((card) => card.handle));

		return {
			solo,
			base: solo ? `/docs/${solo}` : '/docs',
			title: docs?.title || 'Documentation',
			imprint: this._imprint(plan),
			handles,
			sections: sections.map((section) => ({
				id: section.id,
				name: section.name,
				summary: section.summary || '',
				anchor: sectionAnchor(section.id),
				cards: section.cards.map((card) => ({
					handle: card.handle,
					name: card.name,
					body: card.body,
					cardHref: hrefForHandle(card.handle),
					sourceTitle: `Open ${card.handle}`,
					// Same per-type token the connection chips and the graph use, so a
					// handle is one colour everywhere in the app.
					typeStyle: `--c: var(--t-${typeForHandle(card.handle) ?? 'DOC'})`,
				})),
			})),
			empty: sections.length === 0,
			emptyTitle: solo && all.length > 0 ? 'No such section' : 'No documentation yet',
			emptyDescription:
				solo && all.length > 0
					? `No card declares section: ${solo}.`
					: 'Give a card a section: slug and it joins this document. Register the slugs in order on PLAN-PROJECT as doc_sections: to name them and set how they read.',
		};
	}

	/** Cover line: what this document is OF, so a printed copy dates itself. */
	_imprint(plan) {
		const version = plan?.sync?.package_version;
		const today = new Date().toLocaleDateString(undefined, {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		});
		return version ? `v${version} · ${today}` : today;
	}

	mounted() {
		this._onScroll = () => this._spy();
		this._attach();
	}

	afterUpdate() {
		this._attach();
		// Cards arrive a render or two after mount (the plan hydrates async), so
		// the hash can only be honoured once they exist.
		this._scrollToHash();
		this._spy();
	}

	destroyed() {
		this._scroller?.removeEventListener('scroll', this._onScroll);
		this._scroller = null;
		this._onScroll = null;
		setActiveDocAnchor('');
	}

	/** The pane this view scrolls inside; the view itself never scrolls. */
	_attach() {
		if (this._scroller || !this.element) return;
		const scroller = this.element.closest?.('[data-split-pane="second"]');
		if (!scroller) return;
		this._scroller = scroller;
		scroller.addEventListener('scroll', this._onScroll, { passive: true });
	}

	/** Every anchor in document order, with its top relative to the scroller. */
	_anchors() {
		if (!this._scroller) return [];
		return [...this._scroller.querySelectorAll('[data-doc-anchor], .docs-section-title')].map(
			(el) => ({
				id: el.id,
				top: el.offsetTop - this._scroller.offsetTop,
			}),
		);
	}

	_spy() {
		if (!this._scroller) return;
		const anchors = this._anchors().filter((anchor) => anchor.id);
		setActiveDocAnchor(
			anchorAt(anchors, this._scroller.scrollTop + READING_LINE, atBottom(this._scroller)),
		);
	}

	_scrollToHash() {
		const hash = this.route.hash || '';
		if (hash === this._appliedHash) return;
		const id = hash.replace(/^#/, '');
		// An empty hash still counts as applied — otherwise navigating from an
		// anchored URL back to bare /docs would re-scroll on every update.
		if (!id) {
			this._appliedHash = hash;
			return;
		}
		const target = this._scroller?.querySelector(`[id="${CSS.escape(id)}"]`);
		if (!target) return;
		this._appliedHash = hash;
		this._scroller.scrollTo({ top: target.offsetTop - this._scroller.offsetTop - 24 });
	}
}
</script>

<style>
/*
 * TYPOGRAPHY IS SCOPED TO THIS ROUTE. Everything below is under `.docs`, and
 * deliberately so: the rest of the viewer is chrome — rails, lists, tables —
 * and is sized for scanning. This is long-form reading and wants a bigger,
 * higher-contrast setting. Card pages keep the app's type.
 *
 * `--docs-ink` is the seam for that contrast. Document prose runs on the
 * STRONGEST text token rather than the app's mid `--color-body`, and reading it
 * through a docs-scoped variable means a scheme that ever needs a different
 * value can be corrected here without repainting the whole app. (As of now
 * every scheme's `--color-ink` is already near-white in dark and near-black in
 * light, so the alias is enough — checked across all five, both themes.)
 */
.docs {
	--docs-ink: var(--color-ink);
	--docs-measure: 48rem;
	--docs-rail: 13rem;
	--docs-rail-gap: 2.5rem;
	padding: 2rem clamp(1rem, 3vw, 2.5rem) 6rem;
	/* The rail's breakpoint is about how much room the DOCUMENT has, not how
	   wide the window is — collapsing the sidebar should bring the rail back. */
	container: docs / inline-size;
}

/*
 * Equal flexible gutters around a capped column: the document sits in the
 * middle of the content area and STAYS there whether or not the rail is beside
 * it — that is the whole point of putting the contents in a gutter rather than
 * in a pane.
 *
 * The middle track is `min(cap, 100%)`, a definite size, rather than
 * `minmax(0, cap)`. The latter has a fixed 0 minimum, so the two `fr` tracks
 * win the free space and the column collapses on a narrow viewport. There is no
 * `gap` either, for the same reason — the rail pays for its own separation, so
 * the gutters never have to subtract anything from the column.
 */
.docs-grid {
	display: grid;
	grid-template-columns: minmax(0, 1fr) min(var(--docs-measure), 100%) minmax(0, 1fr);
	align-items: start;
}

/*
 * Placement is EXPLICIT, not by source order. A `display: none` grid item is
 * removed from the grid entirely, so auto-placement would slide the column into
 * the rail's track the moment the rail is hidden — the document shifting
 * sideways, which is exactly what this layout exists to prevent.
 */
.docs-rail { grid-column: 1; }
.docs-column { grid-column: 2; min-width: 0; }

/* Marginalia: no border, no fill, no divider, and it scrolls on its own so a
   long contents list never drags the page with it. */
.docs-rail {
	position: sticky;
	top: 1.5rem;
	justify-self: end;
	width: calc(var(--docs-rail) + var(--docs-rail-gap));
	padding-right: var(--docs-rail-gap);
	max-height: calc(100vh - 8rem);
	overflow-y: auto;
	overscroll-behavior: contain;
}

/*
 * The rail shows only when a gutter can hold it WITHOUT overflowing into the
 * document — measure + two full rails, hence the threshold. Below that it goes
 * away and the jump control above the document takes over; the column's width
 * and centring are identical either way.
 */
.docs-compact { display: none; margin-bottom: 1.75rem; }

@container docs (max-width: 78.9rem) {
	.docs-rail { display: none; }
	.docs-compact { display: block; }
}

.docs-cover { border-bottom: 1px solid var(--color-border); padding-bottom: 2.25rem; margin-bottom: 3rem; }
.docs-eyebrow { color: var(--color-faint); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
.docs-title { margin-top: 0.7rem; color: var(--docs-ink); font-size: clamp(2.2rem, 5vw, 3.25rem); font-weight: 650; letter-spacing: -0.035em; line-height: 1.05; }
.docs-imprint { margin-top: 0.8rem; color: var(--color-muted); font-size: 0.9rem; }

.docs-section { margin-top: 4rem; }
.docs-section-title { scroll-margin-top: 1.5rem; color: var(--docs-ink); font-size: 2.1rem; font-weight: 650; letter-spacing: -0.025em; line-height: 1.15; }
.docs-section-summary { margin-top: 0.6rem; color: var(--color-muted); font-size: 1.02rem; line-height: 1.6; }

.docs-card { margin-top: 3rem; scroll-margin-top: 1.5rem; }
.docs-card-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.7rem; color: var(--docs-ink); font-size: 1.5rem; font-weight: 640; letter-spacing: -0.015em; line-height: 1.25; }
/* Quiet on purpose: the way back to the editable card, not a call to action. */
/* An overline above the card title, not a hover affordance: it says which card
   you are reading, which is half of what makes the compiled document navigable.
   `--c` is the card's type token, set inline — one colour per type app-wide. */
.docs-card-source { --c: var(--color-brand); display: inline-block; margin-bottom: 0.3rem; color: var(--c); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-decoration: none; transition: opacity 0.15s; }
.docs-card-source:hover, .docs-card-source:focus-visible { opacity: 0.75; }

/*
 * The document's own type scale, over MarkdownBlock's. Prose runs on --docs-ink
 * rather than --color-body: the app uses body text for secondary information,
 * and in a document the prose IS the content.
 */
.docs-column .md-block { margin-top: 0.9rem; color: var(--docs-ink); font-size: 1.0625rem; line-height: 1.72; }
.docs-column .md-block p { margin: 0.95rem 0; }
.docs-column .md-block li { margin: 0.35rem 0; }
.docs-column .md-block ul, .docs-column .md-block ol { padding-left: 1.5rem; }
.docs-column .md-block h4 { margin: 2rem 0 0.5rem; font-size: 1.16rem; }
.docs-column .md-block h5 { margin: 1.6rem 0 0.4rem; font-size: 1.02rem; }
.docs-column .md-block h6 { margin: 1.5rem 0 0.4rem; font-size: 0.94rem; color: var(--color-muted); }
.docs-column .md-block blockquote { color: var(--color-body); }
.docs-column .md-block table { font-size: 0.95rem; }
.docs-column .md-block pre { font-size: 0.92rem; line-height: 1.6; }

/* Screen shows the rail (or the jump control); paper needs its own contents. */
.docs-paper-toc { display: none; }

@media print {
	.docs { padding: 0; }
	.docs-grid { display: block; }
	.docs-rail, .docs-compact { display: none; }
	.docs-column { max-width: none; }

	.docs-cover { border-bottom: 0; break-after: page; padding-top: 25vh; text-align: center; }
	.docs-title { font-size: 32pt; }
	.docs-card-source { display: none; }

	.docs-paper-toc { display: block; break-after: page; }
	.docs-paper-toc h2 { margin-bottom: 1.2rem; font-size: 18pt; }
	.ptoc-group { margin-bottom: 0.9rem; }
	.ptoc-section { font-weight: 600; }
	.ptoc-card { padding-left: 1.2rem; color: var(--color-muted); }

	/* Every section starts a page; the first one follows the contents page. */
	.docs-section { break-before: page; margin-top: 0; }
	.docs-section-title { font-size: 20pt; }
	.docs-card-title { font-size: 14pt; }
	.docs-section-title, .docs-card-title { break-after: avoid; }
	.docs-card { break-inside: auto; margin-top: 1.8rem; }
	.docs-column .md-block { font-size: 11pt; line-height: 1.55; }
}
</style>
