<puzzle-view>
  <div class="home">
    <HealthStrip model={ health } @sync={ setSyncPoint } />

    <div class="panel-grid">
      <ReleasePanel model={ releases } />
      <ActivityPanel model={ activity } />
      {#if drift.show}<DriftPanel model={ drift } />{/if}
      <NotesPanel model={ notes } />
    </div>

    <div class="plan-body">
      {#if hasPlanCard}
        <Editable multiline value={ planBody } ignore="a, .mermaid-block" @save={ savePlanBody }>
          <MarkdownBlock src={ planBody } />
        </Editable>
      {:else}
        <p class="empty">No plan.md yet — run `constellation init`.</p>
      {/if}
    </div>

    <ConnectedRepos repos={ repos } />
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import ActivityPanel from '../components/ActivityPanel.pzl';
import ConnectedRepos from '../components/ConnectedRepos.pzl';
import DriftPanel from '../components/DriftPanel.pzl';
import Editable from '../components/Editable.pzl';
import HealthStrip from '../components/HealthStrip.pzl';
import MarkdownBlock from '../components/MarkdownBlock.pzl';
import NotesPanel from '../components/NotesPanel.pzl';
import ReleasePanel from '../components/ReleasePanel.pzl';
import { activityModel, driftModel, healthModel, notesModel, releasesModel } from '../lib/dashboard.js';
import { savePatch, stampSyncPoint } from '../lib/edit.js';
import { planIndex } from '../lib/plan-index.js';

// Home — the Overview dashboard: a status board for the plan, in four blocks.
//
//   HealthStrip   the verdict + the counts that qualify it + the one action
//                 that changes it (stamp the sync point)
//   panel grid    Releases · Activity · Code drift · Notes
//   plan body     PLAN-PROJECT's markdown, editable in place
//   repos         connected sibling repos
//
// The panels are presentational — every one takes a single `model` prop built
// by ../lib/dashboard.js, so the thinking is testable without a DOM. Icons and
// tone come from ../lib/icons.js so one glyph vocabulary covers every panel.
//
// Everything comes from the store, so `data()` auto-subscribes: the 20s /api/sync
// poll and the SSE plan reload both re-run it.
//
// PLAN-PROJECT's body is editable in place: saving PATCHes plan.md's body with
// the record's mtime as the optimistic-lock baseline. On a read-only plan
// Editable renders as inert text.
//
// Two things this page deliberately does NOT have any more: a type tile grid
// (the sidebar already lists every type, with the same counts) and a standalone
// stats row (the numbers only mean something next to the freshness verdict, so
// they live in the strip).

/** `connected_repos:` entries, minus anything missing a name or a path. */
function reposOf(card) {
	const raw = card?.frontmatter?.connected_repos;
	if (!Array.isArray(raw)) return [];
	return raw
		.filter((entry) => !!entry && typeof entry === 'object')
		.map((entry) => ({
			name: String(entry.name ?? ''),
			path: String(entry.path ?? ''),
			description: typeof entry.description === 'string' ? entry.description : '',
		}))
		.filter((entry) => entry.name && entry.path);
}

export default class Home extends PuzzleView {
	data() {
		const store = this.ctx.store;
		const plan = store.findOne('plan', 'plan');
		const index = planIndex(store);
		const planCard = index.projectCard;
		const sync = plan?.sync ?? null;

		return {
			health: healthModel(index, sync, {
				errors: plan?.errors?.length ?? 0,
				warnings: plan?.warnings?.length ?? 0,
				editable: plan?.editable !== false,
			}),
			releases: releasesModel(index, sync ?? {}),
			activity: activityModel(sync ?? {}),
			drift: driftModel(sync),
			notes: notesModel(index),
			hasPlanCard: !!planCard,
			planBody: planCard?.body ?? '',
			repos: reposOf(planCard),
		};
	}

	events = {
		savePlanBody: (body) => {
			const card = planIndex(this.ctx.store).projectCard;
			if (!card) return;
			void savePatch(this.ctx.store, card.handle, { body }, card.mtime);
		},

		// Stamping the marker is the one write this page makes that isn't a card
		// edit: it pins "the plan was true at this commit", which is what gives
		// every claim card a drift baseline. Returning the promise lets the strip
		// keep its button in the loading state until the new verdict lands.
		setSyncPoint: () => stampSyncPoint(this.ctx.store),
	};
}
</script>

<style>
.home { width: min(100%, 96rem); margin: 0 auto; padding: 2rem clamp(1.25rem, 4vw, 3.5rem) 4rem; }

@keyframes cst-rise {
	from { opacity: 0; transform: translateY(6px); }
	to { opacity: 1; transform: none; }
}

/* panel grid — the frame is shared by the four *Panel.pzl components; .pzl
   <style> blocks collect into one sheet, so it resolves for them here, the way
   .home-section does for ConnectedRepos. */
/* minmax(0, 1fr), not 1fr: a bare 1fr track floors at min-content, and the
   commit/note rows are `white-space: nowrap`, so their min-content is the whole
   untruncated line (~690px). That pinned the grid at ~1411px, overflowing the
   container below 1920px and clipping the right column instead of ellipsizing.
   The 0 minimum lets the tracks shrink so text-overflow can do its job. */
.panel-grid {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	align-items: start;
	gap: 0.9rem;
	margin: 0 0 2.4rem;
}
.panel {
	border: 1px solid var(--color-border);
	border-radius: 10px;
	background: var(--color-surface);
	padding: 1.1rem 1.4rem;
	animation: cst-rise 0.35s ease both;
}
.panel > h3 {
	display: flex;
	align-items: center;
	gap: 0.4rem;
	margin: 0 0 0.7rem;
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.76rem;
	font-weight: 600;
	letter-spacing: 0.1em;
	text-transform: uppercase;
}
.panel .panel-empty { color: var(--color-faint); font-size: 0.85rem; font-style: italic; }

/* PLAN-PROJECT's markdown body. The page is 96rem wide for the panel grid, but
   prose is not — cap the measure at 70rem and keep it LEFT-aligned (no auto
   margins) so its left edge stays flush with the panels and sections around
   it. Scoped here on purpose: MarkdownBlock is used on card pages too, and
   those layouts set their own width. */
.plan-body { max-width: 70rem; }

.home .empty { color: var(--color-faint); font-size: 0.88rem; font-style: italic; }

/* section frame — shared with ConnectedRepos.pzl */
.home-section { margin: 2.2rem 0; }
.home-section > h3 {
	margin: 0 0 0.8rem;
	border-bottom: 1px solid var(--color-border);
	padding-bottom: 0.45rem;
	color: var(--color-muted);
	font-family: var(--font-mono);
	font-size: 0.76rem;
	font-weight: 600;
	letter-spacing: 0.1em;
	text-transform: uppercase;
}

@media (max-width: 900px) {
	.panel-grid { grid-template-columns: minmax(0, 1fr); }
}

@media (max-width: 640px) {
	.home { padding-inline: 1rem; }
}
</style>
