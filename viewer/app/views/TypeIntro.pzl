<puzzle-view>
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-1 p-8 text-center" style={ hueStyle }>
    {#if known}
      <span class="text-2xl leading-none" style="color: var(--c)" aria-hidden="true">✦</span>
      <h2 class="mt-1 text-xl text-ink">{ label }</h2>
      <p class="font-mono text-xs text-faint">{ countLabel }</p>
      <p class="mt-2 text-sm text-muted">Select a card from the list to view it.</p>
    {:else}
      <p class="text-sm text-muted">Unknown type: { folder }</p>
    {/if}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import { planIndex } from '../lib/plan-index.js';
import { TYPE_META, typeForFolder } from '../lib/types.js';

// TypeIntro — what `/:folder` shows in the detail pane. A non-empty type never
// actually shows it: picking a type auto-selects its first card (replace(), so
// the bare folder URL doesn't pollute history and Back skips it). The intro
// only renders for an empty type or an unknown folder. Sorted-by-handle "first"
// matches the CardList's ordering, so the selected row is the top row.
//
// The list itself is AppShell's CardList, not this view — this is only the
// right-hand half of the split.

export default class TypeIntro extends PuzzleView {
	data(params) {
		const folder = params.folder;
		const type = typeForFolder(folder);
		const meta = type ? TYPE_META[type] : undefined;
		if (!meta) return { known: false, folder };

		const cards = planIndex(this.ctx.store).byType.get(type) ?? [];
		const count = cards.length;
		const first =
			count > 0
				? cards.reduce((a, b) => (a.handle < b.handle ? a : b)).handle
				: null;

		return {
			known: true,
			folder,
			firstHandle: first,
			label: meta.label,
			countLabel: `${count} card${count === 1 ? '' : 's'}`,
			hueStyle: `--c: var(--t-${type})`,
		};
	}

	mounted() {
		this._openFirst();
	}

	afterUpdate() {
		// The plan hydrates asynchronously — on a cold deep link the store may be
		// empty at mount, so retry once data lands (guarded by firstHandle).
		this._openFirst();
	}

	_openFirst() {
		const { firstHandle, folder } = this.getData();
		if (firstHandle) this.ctx.router.replace(`/${folder}/${firstHandle}`);
	}
}
</script>
