<puzzle-view>
  <!-- A component template needs ONE element root, so the two renders live
       inside this wrapper rather than being two roots. It is layout-free: the
       variant class that CSS switches on sits on the child. -->
  <div>
    {#if compact}
      <div class="docs-compact">
        <label class="sr-only" for={ selectId }>Jump to a section</label>
        <select id={ selectId } class="dtoc-select" @change={ jump(event) }>
          <option value="">Contents…</option>
          {#for row in flat}
            <option key={ row.href } value={ row.href } selected={ row.selected }>{ row.label }</option>
          {/for}
        </select>
      </div>
    {:else}
      <nav class="dtoc" aria-label="Documentation contents">
        <p class="dtoc-head">Contents</p>
        {#if solo}
          <!-- The way out of a soloed section: without it the rail is a dead end. -->
          <a class="dtoc-all" href="{ '/docs' | link }">← Whole document</a>
        {/if}

        <!-- Rows truncate in a 13rem gutter, so each carries its full name as a
             tooltip rather than losing it. -->
        {#for section in sections}
          <div key={ section.id } class="dtoc-group">
            <a class={ section.class } href="{ section.href | link }" title={ section.name } aria-current={ section.current }>{ section.name }</a>
            {#for card in section.cards}
              <a key={ card.handle } class={ card.class } href="{ card.href | link }" title={ card.name } aria-current={ card.current }>{ card.name }</a>
            {/for}
          </div>
        {/for}

        {#if sections.length === 0}
          <p class="dtoc-empty">{ emptyText }</p>
        {/if}
      </nav>
    {/if}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import { onActiveDocAnchor, activeDocAnchor, tocTree } from '../lib/docs.js';

// DocsToc — the compiled document's table of contents.
//
// MARGINALIA, NOT A PANE. It floats in the left gutter beside the document
// (DocsPage's three-track grid), sticky, with no border, fill or divider — the
// document stays centred in the viewport and the contents sit next to the page
// rather than pushing it aside. That is also why /docs is one of AppShell's
// `wide` routes and not a split.
//
// TWO LEVELS, and the cards are links. A ten-card section needs its cards
// reachable, not just its heading — a single-level TOC would make the sections
// navigable and the document itself a scroll hunt.
//
// TWO RENDERS, ONE TREE. The gutter cannot hold a legible rail on a narrow
// screen, so the same tree also renders as a jump `<select>` above the document
// (`variant="compact"`). DocsPage mounts both and CSS picks; neither placement
// can move the document sideways.
//
// The highlight is SCROLL-DRIVEN, not route-driven: DocsPage publishes which
// anchor the viewport is on (lib/docs.js) and this subscribes.
//
// Props
//   variant  'rail' (default) | 'compact'
//   solo     section id when the route is /docs/:section, '' on the whole document

const ROW =
	'dtoc-row block truncate rounded-md px-2 py-1 ' +
	'outline-ring focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring';

export default class DocsToc extends PuzzleView {
	data(params, props) {
		const solo = String(props.solo || '');
		const compact = props.variant === 'compact';
		const docs = this.ctx.store.findOne('plan', 'plan')?.docs;
		// The WHOLE document is always listed, even when the centre column is
		// showing one section: the TOC is how you reach the others, and narrowing
		// it to the section you are already reading is a dead end.
		const tree = tocTree(docs?.sections ?? [], {
			base: solo ? `/docs/${solo}` : '/docs',
			solo,
		});
		const active = this.getData().active ?? activeDocAnchor();

		const row = (anchor, extra) => {
			const current = anchor === active;
			return {
				class: `${ROW} ${extra}${current ? ' is-active' : ''}`,
				current: current ? 'true' : false,
			};
		};

		return {
			solo,
			compact,
			selectId: 'dtoc-jump',
			sections: tree.map((section) => ({
				...section,
				...row(section.anchor, 'dtoc-section text-sm font-semibold text-ink'),
				cards: section.cards.map((card) => ({
					...card,
					...row(card.anchor, 'dtoc-card pl-3 text-[0.8rem] text-muted'),
				})),
			})),
			// The select flattens the same two levels; an em space is the only
			// indent an <option> is allowed to have.
			flat: tree.flatMap((section) => [
				{ href: section.href, label: section.name, selected: section.anchor === active },
				...section.cards.map((card) => ({
					href: card.href,
					label: ` ${card.name}`,
					selected: card.anchor === active,
				})),
			]),
			emptyText: docs ? 'No card carries a section: yet.' : 'Loading…',
		};
	}

	mounted() {
		this._unsubscribe = onActiveDocAnchor((id) => {
			this.setData('active', id);
			this.refresh();
		});
	}

	destroyed() {
		this._unsubscribe?.();
		this._unsubscribe = null;
	}

	events = {
		jump: (event) => {
			const href = event.target.value;
			if (href) void this.ctx.router.push(href);
		},
	};
}
</script>

<style>
/* No border, no fill, no divider — this reads as notes beside the page. */
.dtoc { font-size: 0.85rem; }
.dtoc-head { margin-bottom: 0.5rem; padding-inline: 0.5rem; color: var(--color-faint); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; }
.dtoc-all { display: block; margin-bottom: 0.6rem; padding-inline: 0.5rem; color: var(--color-muted); font-size: 0.75rem; }
.dtoc-all:hover { color: var(--color-ink); }
.dtoc-group + .dtoc-group { margin-top: 0.6rem; }
.dtoc-row:hover { color: var(--color-ink); }
.dtoc-row.is-active { background: color-mix(in oklab, var(--color-brand) 16%, transparent); }
.dtoc-card.is-active { color: var(--color-ink); }
.dtoc-empty { padding: 0.5rem; color: var(--color-muted); font-size: 0.75rem; }

.dtoc-select { width: 100%; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); padding: 0.4rem 0.6rem; color: var(--color-body); font-size: 0.85rem; }
</style>
