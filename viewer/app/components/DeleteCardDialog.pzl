<puzzle-view>
  <span class="delete-dialog">
    <AlertDialog
      open={ open }
      title={ title }
      description={ description }
      confirmLabel={ confirmLabel }
      destructive
      @confirm={ confirm }
      @cancel={ cancel }/>
  </span>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import AlertDialog from './ui/AlertDialog.pzl';
import { toast } from './ui/toast.js';
import { removeCard } from '../lib/edit.js';
import { t } from '../lib/i18n.js';
import { planIndex } from '../lib/plan-index.js';
import { folderForType } from '../lib/types.js';

// DeleteCardDialog — the confirm step in front of DELETE /api/card/:handle.
//
// Deleting a card is the one viewer write that can damage the graph: every
// connection pointing at it becomes an E005 dangling reference. So the prompt
// names the neighbours BEFORE the delete (from planIndex — the same undirected
// connection set the graph draws), not after: the server's `referenced_by` only
// arrives with the response, by which point the file is already gone.
//
// Props: open, handle. Callback: @close (the parent owns `open`).
//
// On success the plan reloads (lib/api's write path) and we land on the type
// list the card was in — where the card list is already mounted and now one row
// shorter.

export default class DeleteCardDialog extends PuzzleView {
	data(params, props) {
		const handle = String(props.handle || '');
		const store = this.ctx.store;
		const card = handle ? store.findOne('card', handle) : null;
		const neighbors = handle ? (planIndex(store).neighbors.get(handle) ?? []) : [];

		// Whole sentences rather than spliced fragments: with/without the file
		// path, and no / one / several neighbours. One-vs-several is grammatical
		// number ("that connection" / "those connections"), not a printed count,
		// so it is two keys rather than a CLDR plural entry.
		const path = card?.relPath || '';
		const vars = { handle, path, handles: neighbors.join(', ') };
		let key;
		if (neighbors.length === 0) key = path ? 'card.delete.unreferencedAt' : 'card.delete.unreferenced';
		else if (neighbors.length === 1) key = path ? 'card.delete.referencedAt.single' : 'card.delete.referenced.single';
		else key = path ? 'card.delete.referencedAt.multiple' : 'card.delete.referenced.multiple';
		const description = t(key, vars);

		return {
			open: !!props.open,
			handle,
			title: handle ? t('card.delete.title', { handle }) : t('card.delete.titleNoHandle'),
			confirmLabel: t('card.delete.confirm'),
			description,
			folder: folderForType(card?.type) || '',
		};
	}

	events = {
		cancel: () => this.props.close?.(),

		confirm: async () => {
			const { handle, folder } = this.getData();
			this.props.close?.();

			const result = await removeCard(this.ctx.store, handle);
			if (!result.ok) return;

			const dangling = result.value?.referenced_by ?? [];
			const handles = dangling.join(', ');
			toast(
				dangling.length
					? {
							message: t(
								dangling.length === 1 ? 'card.delete.doneDangling.single' : 'card.delete.doneDangling.multiple',
								{ handle, handles },
							),
						}
					: { message: t('card.delete.done', { handle }), variant: 'success' },
			);
			void this.ctx.router.push(folder ? `/${folder}` : '/');
		},
	};
}
</script>
