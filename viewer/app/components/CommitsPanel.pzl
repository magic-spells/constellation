<puzzle-view>
  <section class="panel panel-commits">
    <h3>Code commits</h3>
    {#if show}
      <ul class="commit-rows">
        {#for row in rows}
          <li key={ row.key } class="commit-row">
            <span class="c-when">{ row.when }</span>
            <span class="c-subject">{ row.subject }</span>
          </li>
        {/for}
      </ul>
    {:else}
      <p class="panel-empty">No recent code commits.</p>
    {/if}
  </section>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';

// CommitsPanel — recent commits touching the code the plan binds to, newest
// first. Presentational only: one `model` prop, shaped by `commitsModel()` in
// ../lib/dashboard.js.
//
// The server may send fewer rows than asked for (or none at all) — render what
// arrived, and say so plainly when the repo has been quiet.

export default class CommitsPanel extends PuzzleView {
	data(params, props) {
		const model = props.model ?? {};
		const rows = Array.isArray(model.rows) ? model.rows : [];

		return {
			show: !!model.show && rows.length > 0,
			rows: rows.map((row, i) => ({
				key: row.key ?? i,
				when: row.when ?? '',
				subject: row.subject ?? '',
			})),
		};
	}
}
</script>

<style>
.commit-rows { display: flex; flex-direction: column; gap: 0.1rem; margin: 0; padding: 0; list-style: none; }
.commit-row { display: flex; align-items: baseline; gap: 0.7rem; min-width: 0; padding: 0.3rem 0; font-size: 0.85rem; }
.commit-row .c-when { flex: none; width: 5.5rem; color: var(--color-faint); font-family: var(--font-mono); font-size: 0.72rem; }
.commit-row .c-subject { flex: 1; overflow: hidden; min-width: 0; color: var(--color-body); text-overflow: ellipsis; white-space: nowrap; }
</style>
