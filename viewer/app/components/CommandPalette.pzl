<puzzle-view>
  <Command
    open={ open }
    morphSource={ morphSource }
    items={ items }
    label={ t('palette.label') }
    placeholder={ t('palette.placeholder') }
    emptyText={ t('palette.empty') }
    @input={ onQuery }
    @select={ run }
    @close={ close }/>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Command from './ui/Command.pzl';
import { planIndex } from '../lib/plan-index.js';
import { GROUPS, hrefForHandle, TYPE_META, typeLabel } from '../lib/types.js';
import { t } from '../lib/i18n.js';
import { SCHEMES, current as currentAppearance, set as setAppearance } from '../lib/appearance.js';

// CommandPalette — everything in the plan, one ⌘K away: every card (grouped by
// type), the standing pages, and the five schemes.
//
// CONTROLLED BY THE SHELL. AppShell owns `open` (it binds the global hotkey and
// the topbar's Search button) and this component owns what is IN the palette.
// The Command piece owns the dialog, the roving keyboard nav, and its own
// filtering — see components/ui/Command.pzl.
//
// Props
//   open         whether the dialog is showing
//   morphSource  the element the palette grows out of (the header's search
//                button when it was clicked); defaults to the
//                `[data-morph-source="search"]` selector, which is what ⌘K uses.
//                Command skips the morph under prefers-reduced-motion.
// Callbacks
//   @close()  asked for on Escape, a backdrop click, or any activation
//
// WHY WE MIRROR THE QUERY. The "at most 8 rows per type" cap can't be applied
// to an unfiltered list — capping it would make the 9th API card permanently
// unsearchable. So Command reports each keystroke through `@input`, we filter
// the cards ourselves with the same substring rule Command uses, and cap each
// type at PER_GROUP. Command then re-filters a list that already matches, which
// is a no-op, and does the ranking and grouping.
//
// Item values are `kind:arg` strings so one `select` handler covers all three
// kinds of row; a card's label is its name with the handle as the right-hand
// hint, and the handle also rides along in `keywords` so typing "API-TIC"
// matches a card whose name says nothing of the sort.
//
// Labels are locale keys, translated in data(). Command matches label +
// keywords, so the label already matches in the reader's language; the
// English keywords stay, and each row also carries its translated kind word
// ("page", "scheme") so those searches work in the reader's language too.

const PER_GROUP = 8;

// The header's search button carries this attribute (layouts/AppShell.pzl). It
// is the morph's fallback source when no clicked element is handed over (⌘K).
const SEARCH_SOURCE = '[data-morph-source="search"]';

const PAGES = [
	{ path: '/', labelKey: 'nav.overview' },
	// Both Tasks views are listed rather than the destination alone: the palette
	// is a jump-to, and "list" is the word someone reaches for when they want the
	// shipped/ahead reading. Unconditional, matching the sidebar's Tasks row —
	// the empty state is what teaches FEATURE cards.
	{ path: '/tasks/board', labelKey: 'palette.page.tasksBoard' },
	{ path: '/tasks/list', labelKey: 'palette.page.tasksList' },
	// Both readings, for the same reason as Tasks: "atlas" and "graph" are the
	// words people reach for, not the destination name.
	{ path: '/constellation/graph', labelKey: 'palette.page.graph' },
	{ path: '/constellation/atlas', labelKey: 'palette.page.atlas' },
	// Shown only when the plan has cards behind them, exactly like the sidebar.
	{ path: '/style-guide', labelKey: 'nav.styleGuide', needs: 'STYLE' },
];

// Types in sidebar order: group by group, and within a group the order they are
// declared in TYPE_META.
const TYPES_IN_ORDER = GROUPS.flatMap((group) =>
	Object.keys(TYPE_META).filter((type) => TYPE_META[type].group === group),
);

export default class CommandPalette extends PuzzleView {
	created() {
		this._wasOpen = false;
		this.setData({ query: '' });
	}

	data(params, props) {
		const open = props.open === true;
		const query = this.getData().query ?? '';
		const q = query.trim().toLowerCase();
		const index = planIndex(this.ctx.store);
		const items = [];
		const goTo = t('palette.group.goTo');
		const pageWord = t('palette.keyword.page');
		const schemeGroup = t('palette.group.scheme');

		for (const page of PAGES) {
			if (page.needs && !(index.byType.get(page.needs)?.length > 0)) continue;
			items.push({
				value: `page:${page.path}`,
				label: t(page.labelKey),
				// Not "Pages": that is the PAGE type's own label, and two groups of
				// the same name would merge into one list.
				group: goTo,
				keywords: ['page', page.path, pageWord],
			});
		}

		for (const type of TYPES_IN_ORDER) {
			const cards = index.byType.get(type);
			if (!cards?.length) continue;
			const matched = cards
				.filter((card) => !q || this._matches(card, q))
				.sort((a, b) => a.handle.localeCompare(b.handle))
				.slice(0, PER_GROUP);

			for (const card of matched) {
				items.push({
					value: `card:${card.handle}`,
					label: card.name || card.handle,
					hint: card.handle,
					group: typeLabel(type),
					keywords: [card.handle],
				});
			}
		}

		const scheme = currentAppearance().scheme;
		for (const option of SCHEMES) {
			items.push({
				value: `scheme:${option.value}`,
				label: t(option.labelKey),
				group: schemeGroup,
				hint: option.value === scheme ? t('palette.hint.active') : '',
				keywords: ['scheme', 'theme', 'palette', 'appearance', option.value, schemeGroup, t('appearance.title')],
			});
		}

		return { open, items, morphSource: props.morphSource || SEARCH_SOURCE };
	}

	_matches(card, q) {
		return (
			card.handle.toLowerCase().includes(q) || (card.name ?? '').toLowerCase().includes(q)
		);
	}

	mounted() {
		this._wasOpen = this.props.open === true;
	}

	// Command clears its own query on the closed→open edge; ours has to follow or
	// the first paint of a reopened palette would be filtered by last time's text.
	afterUpdate() {
		const open = this.props.open === true;
		if (open === this._wasOpen) return;
		this._wasOpen = open;
		if (open && this.getData().query) {
			this.setData('query', '');
			this.refresh();
		}
	}

	events = {
		onQuery: (query) => {
			if (this.getData().query === query) return;
			this.setData('query', query);
			this.refresh();
		},

		// Activation always dismisses first — the palette is a launcher, not a
		// workspace — then does the thing. Closing before navigating also hands
		// focus back before the router moves it to the incoming view.
		run: (value) => {
			this.props.close?.();
			const raw = String(value);
			const split = raw.indexOf(':');
			const kind = raw.slice(0, split);
			const arg = raw.slice(split + 1);

			if (kind === 'card') this.ctx.router.push(hrefForHandle(arg));
			else if (kind === 'page') this.ctx.router.push(arg);
			else if (kind === 'scheme') setAppearance({ scheme: arg });
		},

		close: () => this.props.close?.(),
	};
}
</script>
