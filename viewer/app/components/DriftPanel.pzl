<puzzle-view>
  <div class="contents">
    {#if show}
      <section class="panel panel-drift">
        <h3><Icon name="pulse" size="0.85rem"/> Code drift</h3>

        <p class={ headClass }>
          <Icon name={ headIcon } size="1.05rem"/>
          <span class="d-headline">{ headline }</span>
        </p>

        {#if hasRows}
          <ul class="drift-rows">
            {#for row in rows}
              <li key={ row.handle } class="drift-row">
                <a class="d-handle" href="{ row.path | link }">{ row.handle }</a>
                <Badge variant={ row.statusVariant } class={ row.statusTint }>{ row.status }</Badge>
                <span class="d-meta">{ row.changedCount } file{ row.plural } changed · { row.baselineSource }</span>
              </li>
            {/for}
          </ul>
          {#if overflow}<p class="d-overflow">+{ overflow } more stale card{ overflowPlural }</p>{/if}
        {/if}

        {#if hasUntracked}
          <p class="d-untracked">
            <Icon name="target" size="0.9rem"/>
            <span><b>{ untrackedCount }</b> claim{ untrackedPlural } with no baseline — { untrackedHint }</span>
          </p>
        {/if}
      </section>
    {/if}
  </div>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Icon from './Icon.pzl';
import Badge from './ui/Badge.pzl';

// DriftPanel — the reverse-drift verdict: cards whose bound code moved since
// the baseline they were verified against. Presentational only: one `model`
// prop, shaped by `driftModel()` in ../lib/dashboard.js.
//
// This is a VERDICT, not a list. It leads with one coloured line you can read
// in a glance — green when every claim holds, amber when something moved, grey
// when nothing is tracked yet — and only then shows the handful of cards worth
// naming. The claims with no reachable baseline collapse to a single counted
// line with the fix: on a plan that has never been synced that bucket holds
// every card, and 49 identical rows say nothing one sentence can't.
//
// The panel disappears entirely when there is no verdict to report (no git, or
// the sync route has not answered yet).
//
// `.panel` itself is Home.pzl's (its only caller); .pzl <style> blocks collect
// into one sheet, so the frame resolves there.

// `baseline_source` is a wire token — say what it means instead.
const BASELINE_COPY = {
	verified_sha: 'since verify',
	'card-commit': 'since the card was last committed',
	'sync-marker': 'since sync point',
	argument: 'since base',
};

export default class DriftPanel extends PuzzleView {
	data(params, props) {
		const model = props.model ?? {};
		const rows = Array.isArray(model.rows) ? model.rows : [];
		const untracked = model.untracked ?? null;
		const clean = model.clean !== false;
		// Clean-but-nothing-tracked is its own state: not a warning (nothing is
		// wrong) but not a green tick either (nothing has been checked).
		const nothingTracked = clean && rows.length === 0 && !!untracked && untracked.count > 0;

		return {
			show: !!model.show,
			headline: model.headline ?? '',
			headIcon: clean ? (nothingTracked ? 'target' : 'check-circle') : 'alert',
			headClass: clean ? (nothingTracked ? 'd-head muted' : 'd-head good') : 'd-head warn',
			hasRows: rows.length > 0,
			rows: rows.map((row) => ({
				handle: row.handle ?? '',
				path: row.path ?? '',
				name: row.name ?? '',
				status: row.status ?? '',
				statusVariant: row.statusVariant ?? 'default',
				statusTint: row.statusTint ?? '',
				changedCount: row.changedCount ?? 0,
				plural: row.changedCount === 1 ? '' : 's',
				baselineSource: BASELINE_COPY[row.baselineSource] ?? 'since baseline',
			})),
			overflow: model.overflow ?? 0,
			overflowPlural: model.overflow === 1 ? '' : 's',
			hasUntracked: !!untracked && untracked.count > 0,
			untrackedCount: untracked?.count ?? 0,
			untrackedPlural: untracked?.count === 1 ? '' : 's',
			untrackedHint: untracked?.hint ?? '',
		};
	}
}
</script>

<style>
.panel-drift .d-head { display: flex; align-items: center; gap: 0.45rem; margin: 0 0 0.5rem; font-size: 0.92rem; font-weight: 600; }
.panel-drift .d-head.good { color: var(--color-success); }
.panel-drift .d-head.warn { color: var(--color-warning); }
.panel-drift .d-head.muted { color: var(--color-muted); font-weight: 500; }

.drift-rows { display: flex; flex-direction: column; gap: 0.1rem; margin: 0; padding: 0; list-style: none; }
.drift-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; min-width: 0; padding: 0.3rem 0; }
.drift-row .d-handle {
	overflow: hidden;
	max-width: 100%;
	color: var(--color-body);
	font-family: var(--font-mono);
	font-size: 0.78rem;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.drift-row .d-handle:hover { color: var(--color-ink); text-decoration: underline; }
.drift-row .d-meta { margin-left: auto; color: var(--color-faint); font-family: var(--font-mono); font-size: 0.72rem; white-space: nowrap; }
.panel-drift .d-overflow { margin: 0.35rem 0 0; color: var(--color-faint); font-family: var(--font-mono); font-size: 0.72rem; }

/* The untracked bucket is a footnote with a fix in it, never a list. */
.panel-drift .d-untracked {
	display: flex;
	align-items: flex-start;
	gap: 0.45rem;
	margin: 0.9rem 0 0;
	border-top: 1px solid var(--color-border);
	padding-top: 0.7rem;
	color: var(--color-muted);
	font-size: 0.78rem;
	line-height: 1.45;
}
.panel-drift .d-untracked b { color: var(--color-ink); font-weight: 600; }
</style>
