<puzzle-view class="flex h-screen overflow-hidden bg-page text-body">
  <Sidebar class="cnav shrink-0" label="Plan navigation" items={ navItems } activePath={ activePath }>
    <!-- pl-5 = the list's p-2 + row px-3, so the brand lines up with nav rows. -->
    <div slot="header" class="flex items-center gap-2.5 overflow-hidden pl-5 pr-3 pb-1 pt-4">
      <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand-tint text-brand">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l1.7 4.1L18 8.8l-4.3 1.7L12 14.6l-1.7-4.1L6 8.8l4.3-1.7zM18.5 15l.8 1.9 1.9.8-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.8zM5.5 14l.6 1.5 1.5.6-1.5.6L5.5 18l-.6-1.3L3.4 16l1.5-.5z"/>
        </svg>
      </span>
      <span class="min-w-0 truncate text-sm font-semibold tracking-tight text-ink">Constellation</span>
    </div>
  </Sidebar>

  <div class="flex min-w-0 flex-1 flex-col">
    <header class="flex h-14 shrink-0 items-center gap-3 border-b border-border bg-surface px-4">
      <h1 class="min-w-0 truncate text-sm font-semibold text-ink">{ projectName }</h1>
      <SyncBadge/>

      <div class="ml-auto flex shrink-0 items-center gap-3">
        {#if repoUrl}
          <a
            href={ repoUrl }
            target="_blank"
            rel="noopener noreferrer"
            class="grid size-7 place-items-center rounded-lg text-muted transition-colors hover:text-ink outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            aria-label="Open the repository on GitHub">
            <svg class="size-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
          </a>
        {/if}
        <button
          type="button"
          class="hidden cursor-pointer items-center gap-1.5 rounded-lg border border-border bg-surface-sunken px-2 py-1 text-xs text-muted transition-colors hover:text-ink md:flex outline-ring focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
          aria-label="Open the command palette"
          @click={ openPalette }>
          Search
          <Kbd>⌘</Kbd>
          <Kbd>K</Kbd>
        </button>
        <ThemeControls/>
      </div>
    </header>

    <main class="min-h-0 min-w-0 flex-1 overflow-hidden">
      <SplitPanel
        class={ splitClass }
        sizes={ splitSizes }
        defaultSizes={ splitDefaults }
        min={ splitMin }
        max={ splitMax }
        disabled={ splitDisabled }
        storageKey="constellation-list">
        <div slot="first" class="h-full min-h-0">
          {#if split}
            <CardList folder={ activeFolder } activeHandle={ activeHandle } @create={ createCard }/>
          {/if}
        </div>
        <div slot="second" class={ detailClass }><Slot/></div>
      </SplitPanel>
    </main>
  </div>

  <CommandPalette open={ paletteOpen } @close={ closePalette }/>
  <CreateCardDialog open={ createOpen } type={ createType } @close={ closeCreate }/>
  <Toaster/>
</puzzle-view>

<script>
import { PuzzleView } from '@magic-spells/puzzle';
import Sidebar from '../components/ui/Sidebar.pzl';
import SplitPanel from '../components/ui/SplitPanel.pzl';
import Kbd from '../components/ui/Kbd.pzl';
import Toaster from '../components/ui/Toaster.pzl';
import CardList from '../components/CardList.pzl';
import CommandPalette from '../components/CommandPalette.pzl';
import CreateCardDialog from '../components/CreateCardDialog.pzl';
import SyncBadge from '../components/SyncBadge.pzl';
import ThemeControls from '../components/ThemeControls.pzl';
import { planIndex } from '../lib/plan-index.js';
import { GROUPS, TYPE_META, typeForFolder } from '../lib/types.js';

// AppShell — the persistent chrome every route renders inside: the pieces
// Sidebar rail on the left, a topbar carrying the plan's name + freshness +
// appearance controls, and the single Toaster host.
//
// The nav is derived, not authored: `planIndex(store)` gives per-type card
// counts, so a type with no cards simply is not in the rail and each visible
// one carries its count as a badge. That is the Svelte viewer's Nav.svelte
// semantics minus its coloured ✦ bullets — the type's hue now shows up only as
// a 2px accent bar on the ACTIVE row (the `.cnav` rules in styles/styles.css;
// the Sidebar piece is config-first and has no per-item style hook).
//
// Hrefs are mode-encoded through `router.url()` — the exact function the `link`
// formatter wraps. The template can't pipe them because they live in the
// Sidebar's `items` config rather than in markup.
//
// The content region has three shapes, picked from the route (`_region`):
//
//   split      /:folder and /:folder/:handle — a resizable CardList | <Slot/>
//              pair. The list is hosted HERE rather than inside the views so it
//              survives navigation between the cards it lists (filter text and
//              scroll position included) and so both routes get it from one
//              place.
//   bleed      /constellation — the canvas owns the whole box: no padding, no
//              scrolling, and `.shell-bleed` hands 100% height down through the
//              routed <puzzle-view> element (see styles/styles.css).
//   wide       everything else — full width, the view scrolls itself.
//
// All three are the SAME SplitPanel, because a template may declare the default
// slot marker exactly once and <Slot/> is where the router mounts the routed
// view — putting one in each branch of an {#if} is a compile error. So the two
// listless shapes collapse the panel instead: `sizes` switches it to controlled
// [0, 100] with the divider disabled and hidden (`.shell-flat`), and the list
// pane renders nothing. Leaving `sizes` undefined hands the panel back to its
// own uncontrolled state, which is what restores the dragged width from
// localStorage.
//
// The shell also owns the ⌘K palette's OPEN state, because it owns the two
// things that set it: the window-level hotkey (bound in mounted(), released in
// destroyed()) and the topbar's Search button. CommandPalette owns everything
// else about the palette. That state is local UI, so it lives in setData and
// data() reads it back — never in the store.

// Icons are SVG path `d` strings on a 24×24 stroked grid (the Sidebar's icon
// contract). Every row needs one: the collapsed rail shows nothing else.
const PAGE_ICON = {
	overview: 'M3 11l9-7 9 7M5 9.5V20h14V9.5M9.5 20v-6h5v6',
	board: 'M4 4h5v16H4zM10 4h5v11h-5zM16 4h5v7h-5z',
	constellation:
		'M5 5a2 2 0 100 4 2 2 0 100-4M19 7a2 2 0 100 4 2 2 0 100-4M11 16a2 2 0 100 4 2 2 0 100-4M7 6.5l10 1.5M17.5 10.8L12.5 15M9.6 15.2L6.2 9',
	features: 'M6 4v16M6 5h11l-2 3.5L17 12H6',
	style:
		'M12 3a9 9 0 100 18c1.6 0 2-1 1.3-1.9-.7-.9-.2-2.1 1-2.1H17a4 4 0 004-4c0-4.9-4-10-9-10M7.5 12.5h.01M9.5 8.5h.01M14 7.5h.01',
};

const TYPE_ICON = {
	PLAN: 'M8 4h8a1 1 0 011 1v15l-5-2.5L7 20V5a1 1 0 011-1M9.5 9h5',
	FEATURE: 'M6 4v16M6 5h11l-2 3.5L17 12H6',
	RELEASE: 'M3.5 12.5l9-9H20v7.5l-9 9zM16.5 7.5h.01',
	DIAGRAM: 'M9 3h6v4H9zM3 17h6v4H3zM15 17h6v4h-6zM12 7v5M6 17v-3h12v3',
	DOC: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h6M10 16h4',
	DECISION: 'M12 3v18M4 9l8-6 8 6M2 15l2-6 2 6a2.5 2.5 0 01-4 0M18 15l2-6 2 6a2.5 2.5 0 01-4 0',
	AGENT: 'M8 7h8a3 3 0 013 3v5a3 3 0 01-3 3H8a3 3 0 01-3-3v-5a3 3 0 013-3M12 3.5V7M9.5 12h.01M14.5 12h.01',
	API: 'M4 12h5M15 12h5M9.5 7.5L5 12l4.5 4.5M14.5 7.5L19 12l-4.5 4.5',
	DB: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
	DATATYPE: 'M8 4c-2 0-2 2-2 4s-1 4-2 4c1 0 2 2 2 4s0 4 2 4M16 4c2 0 2 2 2 4s1 4 2 4c-1 0-2 2-2 4s0 4-2 4',
	EVENT: 'M13 3L5 14h6l-1 7 8-11h-6z',
	JOB: 'M12 4a8 8 0 100 16 8 8 0 000-16M12 8v4.2l2.8 1.8',
	FLOW: 'M4 4h6v5H4zM14 15h6v5h-6zM7 9v3.5a2 2 0 002 2h5M11.5 12l2.5 2.5-2.5 2.5',
	STATE: 'M6 5a3 3 0 100 6 3 3 0 100-6M18 13a3 3 0 100 6 3 3 0 100-6M9.5 9.5h4a3 3 0 013 3v.5M13.5 9.5l-2-2M13.5 9.5l-2 2',
	ROLE: 'M12 12a4 4 0 100-8 4 4 0 000 8M4.5 20a7.5 7.5 0 0115 0',
	EXTERNAL: 'M14 4h6v6M20 4l-8.5 8.5M18 13.5V19a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5.5',
	PAGE: 'M3.5 5h17v14h-17zM3.5 9.5h17M6.5 7.2h.01M9 7.2h.01',
	COMPONENT: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
	STYLE:
		'M12 3a9 9 0 100 18c1.6 0 2-1 1.3-1.9-.7-.9-.2-2.1 1-2.1H17a4 4 0 004-4c0-4.9-4-10-9-10M7.5 12.5h.01M9.5 8.5h.01M14 7.5h.01',
	FILE: 'M14 3H7a1 1 0 00-1 1v16a1 1 0 001 1h10a1 1 0 001-1V7zM14 3v4h4M9 13h6M9 17h4',
	TEST: 'M9 3h6M10 3v6.2L5.3 18a2 2 0 001.8 3h9.8a2 2 0 001.8-3L14 9.2V3M7.5 15h9',
};

export default class AppShell extends PuzzleView {
	data() {
		const index = planIndex(this.ctx.store);
		// The `link` formatter's own encoder — hash mode here, so '/x' → '#/x'.
		const url = (path) => this.ctx.router.url(path);
		const count = (type) => index.byType.get(type)?.length ?? 0;

		// Board sits directly under Overview and is always present, unlike the
		// Features / Style guide rows below: it is a fixed view of the plan's work
		// (its own empty state teaches FEATURE cards), not a row that exists only
		// because a type has cards.
		const navItems = [
			{ label: 'Overview', href: url('/'), icon: PAGE_ICON.overview },
			{ label: 'Board', href: url('/board'), icon: PAGE_ICON.board },
			{ label: 'Constellation', href: url('/constellation'), icon: PAGE_ICON.constellation },
		];
		if (count('FEATURE') > 0) {
			navItems.push({ label: 'Features', href: url('/features'), icon: PAGE_ICON.features });
		}
		if (count('STYLE') > 0) {
			navItems.push({ label: 'Style guide', href: url('/style-guide'), icon: PAGE_ICON.style });
		}

		for (const group of GROUPS) {
			const types = Object.keys(TYPE_META).filter(
				(type) => TYPE_META[type].group === group && count(type) > 0,
			);
			if (types.length === 0) continue;
			navItems.push({ group });
			for (const type of types) {
				navItems.push({
					label: TYPE_META[type].label,
					href: url(`/${TYPE_META[type].folder}`),
					icon: TYPE_ICON[type],
					badge: count(type),
				});
			}
		}

		const project = index.projectCard;
		const region = this._region();
		const split = region.mode === 'split';

		return {
			navItems,
			activePath: this._activePath(region, url),
			paletteOpen: this.getData().paletteOpen === true,
			// The create dialog lives here rather than in CardList because the list
			// is unmounted the moment we navigate to the card it just created.
			createOpen: this.getData().createOpen === true,
			createType: this.getData().createType || '',
			projectName: project?.frontmatter?.name || project?.name || 'Constellation',
			repoUrl: this.ctx.store.findOne('plan', 'plan')?.repoUrl || '',

			split,
			activeFolder: region.folder,
			activeHandle: region.handle,

			// SplitPanel config. Arrays can't be written inline in a template
			// expression, so every one of these is built here. With a list showing:
			// a quarter of the width by default, pinned between a legible minimum
			// and a width past which the list is just stealing space from the card;
			// committed sizes persist under `split-panel:constellation-list`.
			// Without one: controlled at [0, 100], divider disabled and hidden.
			splitClass: split ? 'h-full' : 'shell-flat h-full',
			splitSizes: split ? undefined : [0, 100],
			splitDefaults: split ? [24, 76] : [0, 100],
			splitMin: split ? ['220px', '360px'] : [null, null],
			splitMax: split ? ['480px', null] : [null, null],
			splitDisabled: !split,
			detailClass:
				region.mode === 'bleed' ? 'shell-bleed h-full overflow-hidden' : 'min-h-full',
		};
	}

	// ⌘K / Ctrl+K from anywhere in the app. The listener is on `window` because
	// the palette must open no matter what has focus — including the canvas graph
	// and the split-panel divider, neither of which is inside a form control the
	// browser would route a key event through to us.
	mounted() {
		this._onHotkey = (event) => {
			if (event.altKey || !(event.metaKey || event.ctrlKey)) return;
			if ((event.key || '').toLowerCase() !== 'k') return;
			event.preventDefault();
			this._setPalette(true);
		};
		window.addEventListener('keydown', this._onHotkey);
	}

	destroyed() {
		if (this._onHotkey) window.removeEventListener('keydown', this._onHotkey);
		this._onHotkey = null;
	}

	_setPalette(open) {
		if (this.getData().paletteOpen === open) return;
		this.setData('paletteOpen', open);
		this.refresh();
	}

	// Which content shape the current route wants, plus what the list column
	// should be showing. Both list-bearing routes start with a folder segment
	// (`/api`, `/api/API-TICKETS`), so the FIRST path param decides: a known type
	// folder gets the list, anything else falls back to the wide layout and lets
	// the view own the whole box (TypeIntro's "unknown type", CardPage's "not in
	// this plan").
	_region() {
		if (this.route.route?.name === 'graph') {
			return { mode: 'bleed', folder: null, handle: null };
		}

		const params = this.route.params || {};
		const folder = params.folder ? String(params.folder) : '';
		const handle = params.handle ? String(params.handle).toUpperCase() : null;

		if (folder && typeForFolder(folder)) return { mode: 'split', folder, handle };
		return { mode: 'wide', folder: null, handle };
	}

	// The Sidebar matches `activePath` against an item's href byte-for-byte, so
	// this resolves the current route to the href of the row that owns it: a
	// card page highlights its TYPE row (the Svelte Nav's `activeFolder` prop),
	// which is now simply the first segment of its own URL.
	_activePath(region, url) {
		if (region.folder) return url(`/${region.folder}`);
		// A folder segment we don't recognise owns no row — highlight nothing
		// rather than falling through and matching a page.
		if (this.route.params?.folder) return '';
		// The board's preview dialog is a child route, so the pathname grows to
		// `/board/card/HANDLE` while it is open. It is still the Board row.
		if (String(this.route.route?.name ?? '').startsWith('board')) return url('/board');
		return url(this.route.pathname || '/');
	}

	events = {
		openPalette: () => this._setPalette(true),
		closePalette: () => this._setPalette(false),

		createCard: (type) => {
			this.setData({ createType: type, createOpen: true });
			this.refresh();
		},
		closeCreate: () => {
			this.setData('createOpen', false);
			this.refresh();
		},
	};
}
</script>
